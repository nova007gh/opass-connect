{
  "name": "@opass/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=../../packages/db/prisma/schema.prisma",
    "prisma:resolve": "prisma migrate resolve --schema=../../packages/db/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../../packages/db/prisma/schema.prisma",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.3",
    "@opass/db": "workspace:*",
    "@opass/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "livekit-server-sdk": "^2.13.3",
    "openai": "^5.12.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
